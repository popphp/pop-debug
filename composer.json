{
    "name": "popphp/pop-debug",
    "description": "Pop Debug Component for Pop PHP Framework",
    "keywords": [
        "debugger",
        "php debugger",
        "php",
        "pop",
        "pop php"
    ],
    "homepage": "https://github.com/popphp/pop-debug",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona",
            "email": "dev@noladev.com",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "popphp/pop-csv": "^4.2.1",
        "popphp/pop-db": "^7.0.0-beta.3",
        "popphp/pop-http": "^6.0.0-beta.6",
        "popphp/pop-log": "^5.0.0-beta-1",
        "popphp/pop-session": "^5.0.0-beta.1",
        "popphp/pop-utils": "^3.0.0-beta.3",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Debug\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Debug\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.0.x-dev"
        }
    }
}
